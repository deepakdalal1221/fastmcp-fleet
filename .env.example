MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_LOG_LEVEL=INFO
MCP_LOG_FORMAT=json
MCP_ENV=dev

# Optional auth (empty = disabled)
MCP_AUTH_TOKEN=

# Per-server secrets (examples; scope by server prefix)
GITHUB_TOKEN=
POSTGRES_DSN=postgresql://user:pass@localhost:5432/db
SLACK_BOT_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
